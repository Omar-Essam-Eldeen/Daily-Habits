# 21 Habits v3 — environment variables (NAMES ONLY — never commit real values)
# Set these in Vercel: Project → Settings → Environment Variables.
# See PUSH-SETUP.md for the full free setup walkthrough.

# Upstash Redis (free tier) — stores push subscriptions only, no habit data.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Web Push identity. Generate a pair once with: npx web-push generate-vapid-keys
# The public key also ships in the client (VITE_VAPID_PUBLIC_KEY overrides the built-in default at build time).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Shared secret that protects /api/send-reminders for manual/fallback calls
# (also put it in the QStash schedule URL as ?key=... or rely on QStash signing keys below).
CRON_SECRET=

# Upstash QStash signing keys (from the QStash console) — used to verify scheduled calls.
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Optional build-time override of the client's VAPID public key.
VITE_VAPID_PUBLIC_KEY=
